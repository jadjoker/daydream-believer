# Copy this file to .env and fill in your API keys
# All of these have free tiers — sign up at the links below

# Finnhub — https://finnhub.io/register (free: 60 calls/min)
FINNHUB_API_KEY=your_finnhub_key_here

# FRED (Federal Reserve Economic Data) — https://fred.stlouisfed.org/docs/api/api_key.html (free, instant)
# Provides: CPI, Fed funds rate, GDP growth, unemployment — used for macro context in AI picks
FRED_API_KEY=your_fred_key_here

# Alpha Vantage — https://www.alphavantage.co/support/#api-key (free: 25 calls/day)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Reddit — https://www.reddit.com/prefs/apps (create a script app, free)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=DaydreamBeliever/1.0

# NewsAPI — https://newsapi.org/register (free: 100 calls/day)
NEWS_API_KEY=your_newsapi_key_here

# Optional: Unusual Whales — https://unusualwhales.com (limited free tier)
UNUSUAL_WHALES_API_KEY=

# Picks passcode — protects the /picks page and all /ai/* endpoints
# Set any string you want; leave blank to disable protection (local dev)
PICKS_PASSCODE=your_secret_passcode_here

# Cache settings
CACHE_TTL_SECONDS=300
DISK_CACHE_DIR=./cache_data
